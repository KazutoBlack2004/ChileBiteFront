---
import "@/styles/global.css";
import Footer from "@/shared/layout/Footer";
import Navbar from "@/shared/layout/Navbar";
import BaseHead from "@/shared/layout/BaseHead.astro";
import { LocalesSection } from "@/features/locales/components/LocalesSection";
---

<html lang="es">
  <head>
    <BaseHead />
    <title>
      Marketplace | ChileBite - Mercado de Sabores y Productos Frescos
    </title>
    <meta
      name="description"
      content="Explora el Marketplace de ChileBite: ferias libres, verdulerías de barrio y productos frescos del territorio chileno directo en tu mapa."
    />
  </head>

  <body class="transition-colors duration-300 min-h-screen flex flex-col bg-bg-page text-text-main w-full max-w-full overflow-x-clip">
    <Navbar client:only="react">
      <div slot="fallback" class="fixed top-0 left-0 right-0 h-20 z-50 bg-bg-page/80 backdrop-blur-xl border-b border-border-subtle"></div>
    </Navbar>

    <main class="flex-grow min-h-[calc(100vh-80px)] pt-20 w-full max-w-full overflow-x-clip">
      <LocalesSection client:only="react">
        <div slot="fallback" class="w-full min-h-screen animate-pulse">
          <div class="h-[55vh] w-full bg-zinc-900/90 flex flex-col items-center justify-center px-6 space-y-5">
            <div class="h-12 w-3/4 max-w-xl rounded-2xl bg-zinc-800"></div>
            <div class="h-5 w-2/3 max-w-md rounded-xl bg-zinc-800"></div>
            <div class="h-14 w-full max-w-2xl rounded-full bg-zinc-800"></div>
          </div>
          <div class="max-w-7xl mx-auto px-6 py-10 space-y-8">
            <div class="h-12 w-full rounded-full bg-surface-muted dark:bg-zinc-800"></div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              <div class="h-80 rounded-2xl bg-surface-muted dark:bg-zinc-800"></div>
              <div class="h-80 rounded-2xl bg-surface-muted dark:bg-zinc-800"></div>
              <div class="h-80 rounded-2xl bg-surface-muted dark:bg-zinc-800"></div>
            </div>
          </div>
        </div>
      </LocalesSection>
    </main>

    <Footer client:only="react" />

    <style is:global>
      html, body {
        max-width: 100vw;
        overflow-x: clip;
      }
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </body>
</html>
