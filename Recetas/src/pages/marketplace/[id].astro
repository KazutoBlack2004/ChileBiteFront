---
import "@/styles/global.css";
import Footer from "@/shared/layout/Footer";
import Navbar from "@/shared/layout/Navbar";
import BaseHead from "@/shared/layout/BaseHead.astro";
import { SellerCatalogView } from "@/features/locales/components/SellerCatalogView";
import { locales } from "@/features/locales/data/locales";

export async function getStaticPaths() {
  return locales.map((locale) => ({
    params: { id: locale.id },
    props: { locale },
  }));
}

const { id } = Astro.params;
const { locale: initialLocale } = Astro.props;
const locale = initialLocale || locales.find((l) => l.id === id);

if (!locale) {
  return Astro.redirect("/marketplace");
}

const title = `${locale.name} | Catálogo en ChileBite`;
const description = `Consulta el catálogo completo de productos frescos, precios y ubicación de ${locale.name} (${locale.address || locale.commune}). Contacta directo por WhatsApp.`;
---

<html lang="es">
  <head>
    <BaseHead />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={locale.image} />
  </head>

  <body class="transition-colors duration-300 min-h-screen flex flex-col bg-bg-page text-text-main w-full max-w-full overflow-x-clip">
    <Navbar client:only="react">
      <div slot="fallback" class="fixed top-0 left-0 right-0 h-20 z-50 bg-bg-page/80 backdrop-blur-xl border-b border-border-subtle"></div>
    </Navbar>

    <main class="flex-grow min-h-[calc(100vh-80px)] pt-20 pb-16 w-full max-w-full overflow-x-clip">
      <SellerCatalogView locale={locale} client:only="react">
        <div slot="fallback" class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8 animate-pulse">
          <div class="h-6 w-40 rounded-lg bg-surface-muted dark:bg-zinc-800"></div>
          <div class="h-96 w-full rounded-3xl bg-surface-muted dark:bg-zinc-800"></div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="h-44 rounded-2xl bg-surface-muted dark:bg-zinc-800"></div>
            <div class="h-44 rounded-2xl bg-surface-muted dark:bg-zinc-800"></div>
            <div class="h-44 rounded-2xl bg-surface-muted dark:bg-zinc-800"></div>
            <div class="h-44 rounded-2xl bg-surface-muted dark:bg-zinc-800"></div>
          </div>
          <div class="h-[500px] w-full rounded-3xl bg-surface-muted dark:bg-zinc-800"></div>
        </div>
      </SellerCatalogView>
    </main>

    <Footer client:only="react" />
  </body>
</html>
